<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PayrollCalculator">

        <!-- singleTop: backup for the system's Up navigation. When Up clears the
             activities above MainActivity, the existing MainActivity gets onNewIntent()
             instead of being destroyed and recreated. (AboutActivity's back arrow
             calls finish(), so this path is not normally used.) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PayrollCalculator"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- parentActivityName tells Android that "Up" from About goes to MainActivity. -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/about_title"
            android:parentActivityName=".MainActivity" />
    </application>

</manifest>
